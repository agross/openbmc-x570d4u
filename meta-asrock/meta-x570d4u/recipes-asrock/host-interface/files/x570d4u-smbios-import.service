[Unit]
Description=Convert and import host SMBIOS
Requires=smbios-mdrv2.service
After=smbios-mdrv2.service xyz.openbmc_project.Software.Manager.service
Wants=xyz.openbmc_project.Software.Manager.service

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/libexec/x570d4u-smbios-import
Restart=on-failure
RestartSec=5

