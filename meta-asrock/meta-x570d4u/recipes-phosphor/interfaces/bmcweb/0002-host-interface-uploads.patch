 // checks if request can be forwarded without authentication
+inline bool isAmiInventoryUpload(std::string_view url,
+                                 boost::beast::http::verb method)
+{
+    if (url.ends_with('/') && url != "/")
+    {
+        url.remove_suffix(1);
+    }
+    if (url == "/redfish/v1/Oem/Ami/InventoryData")
+    {
+        return method == boost::beast::http::verb::get ||
+               method == boost::beast::http::verb::post ||
+               method == boost::beast::http::verb::patch;
+    }
+    if (method == boost::beast::http::verb::patch &&
+        url == "/redfish/v1/oem/ami/configuredbsnapshot")
+    {
+        return true;
+    }
+    if (method != boost::beast::http::verb::post)
+    {
+        return false;
+    }
+    constexpr std::string_view registry = "/redfish/v1/Registries/BiosAttributeRegistry";
+    return url == "/redfish/v1/Oem/Ami/InventoryData" ||
+           url == "/redfish/v1/BiosStaticFiles" ||
+           url == "/redfish/v1/Systems/Self/Bios" ||
+           url == "/redfish/v1/Systems/Self/Smbios" ||
+           (url.starts_with(registry) && url.ends_with(".json") &&
+            url.find('/', registry.size()) == std::string_view::npos);
+}
+
 inline bool isOnAllowlist(std::string_view url, boost::beast::http::verb method)
 {
