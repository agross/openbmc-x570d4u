+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright OpenBMC Authors
+#pragma once
+
+#include "app.hpp"
+#include "async_resp.hpp"
+#include "logging.hpp"
+
+#include <boost/beast/http/field.hpp>
+#include <boost/beast/http/status.hpp>
+#include <boost/beast/http/verb.hpp>
+
+#include <filesystem>
+#include <cctype>
+#include <fstream>
+#include <string>
+#include <string_view>
+
+#include <nlohmann/json.hpp>
+
+namespace redfish
+{
+namespace x570d4u
+{
+constexpr std::string_view inventoryPath =
+    "/var/lib/x570d4u-bios-uploads/rf-inventory.json";
+constexpr std::string_view pendingInventoryPath =
+    "/var/lib/x570d4u-bios-uploads/rf-inventory.pending.json";
+constexpr size_t maxInventorySize = 512U * 1024U;
+
+inline bool saveInventory(std::string_view payload)
+{
+    if (payload.size() > maxInventorySize)
+    {
+        return false;
+    }
+
+    nlohmann::json inventory = nlohmann::json::parse(payload, nullptr, false);
+    if (inventory.is_discarded() || !inventory.is_object())
+    {
+        return false;
+    }
+
+    if (!inventory.contains("Systems") || !inventory.contains("Chassis"))
+    {
+        return false;
+    }
+
+    const std::filesystem::path output(pendingInventoryPath);
+    std::error_code ec;
+    std::filesystem::create_directories(output.parent_path(), ec);
+    if (ec)
+    {
+        return false;
+    }
+    const std::filesystem::path temporary = output.string() + ".new";
+    {
+        std::ofstream file(temporary, std::ios::binary | std::ios::trunc);
+        if (!file || !(file << payload))
+        {
+            return false;
+        }
+    }
+    std::filesystem::rename(temporary, output, ec);
+    return !ec;
+}
+
+inline std::string_view getPayload(crow::Request& req)
+{
+    const auto parts = req.multipart();
+    if (parts.empty())
+    {
+        return req.body();
+    }
+    for (const FormPart& part : parts)
+    {
+        const auto disposition = part.fields.find(
+            boost::beast::http::field::content_disposition);
+        if (disposition != part.fields.end() &&
+            disposition->value().contains("name=\"static_file\""))
+        {
+            return part.content;
+        }
+    }
+    return {};
+}
+// Store firmware files within a bounded private directory.
+// Never treat the supplied name as a path.
+inline bool stageUpload(std::string_view name, std::string_view data,
+                        bool persist = true)
+{
+    if (name.empty() || name.size() > 128 || name.find("..") != name.npos ||
+        data.empty() || data.size() > 4U * 1024U * 1024U)
+    {
+        return false;
+    }
+    for (unsigned char c : name)
+    {
+        if (!std::isalnum(c) && c != '.' && c != '_' && c != '-')
+        {
+            return false;
+        }
+    }
+    if (!persist)
+    {
+        return true;
+    }
+    std::error_code ec;
+    const std::filesystem::path directory("/var/lib/x570d4u-bios-uploads");
+    std::filesystem::create_directories(directory, ec);
+    if (ec)
+    {
+        return false;
+    }
+    std::filesystem::permissions(directory, std::filesystem::perms::owner_all,
+                                 std::filesystem::perm_options::replace, ec);
+    if (ec)
+    {
+        return false;
+    }
+    const auto capacity = std::filesystem::space(directory, ec);
+    if (ec || capacity.available < data.size() + 8U * 1024U * 1024U)
+    {
+        return false;
+    }
+    const auto destination = directory / name;
+    const auto temporary = directory / (std::string(name) + ".new");
+    {
+        std::ofstream file(temporary, std::ios::binary | std::ios::trunc);
+        if (!file || !file.write(data.data(), static_cast<std::streamsize>(data.size())))
+        {
+            return false;
+        }
+    }
+    std::filesystem::rename(temporary, destination, ec);
+    return !ec;
+}
+
+inline bool isHost(const crow::Request& req)
+{
+    return req.ipAddress.to_string() == "169.254.0.18" ||
+           req.ipAddress.to_string() == "::ffff:169.254.0.18";
+}
+
+inline void respondStaged(const std::shared_ptr<bmcweb::AsyncResp>& resp,
+                          std::string_view name, std::string_view data,
+                          bool persist = true)
+{
+    if (!stageUpload(name, data, persist))
+    {
+        resp->res.result(boost::beast::http::status::bad_request);
+        return;
+    }
+    resp->res.result(boost::beast::http::status::created);
+    resp->res.addHeader(boost::beast::http::field::location,
+                        std::string("/redfish/v1/BiosStaticFiles/") + std::string(name));
+}
+
+} // namespace x570d4u
+
+inline void requestRoutesX570d4uRfInventory(App& app)
+{
+    BMCWEB_ROUTE(app, "/redfish/v1/BiosStaticFiles/")
+        .methods(boost::beast::http::verb::post)(
+            [](crow::Request& req, const std::shared_ptr<bmcweb::AsyncResp>& resp) {
+                if (!x570d4u::isHost(req))
+                {
+                    resp->res.result(boost::beast::http::status::forbidden);
+                    return;
+                }
+                const auto parts = req.multipart();
+                if (parts.size() != 1)
+                {
+                    resp->res.result(boost::beast::http::status::bad_request);
+                    return;
+                }
+                const auto& part = parts.front();
+                const auto disposition = part.fields.find(boost::beast::http::field::content_disposition);
+                if (disposition == part.fields.end())
+                {
+                    resp->res.result(boost::beast::http::status::bad_request);
+                    return;
+                }
+                const std::string_view header(disposition->value().data(), disposition->value().size());
+                const auto start = header.find("filename=\"");
+                if (!header.contains("name=\"static_file\"") || start == header.npos)
+                {
+                    resp->res.result(boost::beast::http::status::bad_request);
+                    return;
+                }
+                const auto begin = start + 10;
+                const auto end = header.find('\"', begin);
+                if (end == header.npos)
+                {
+                    resp->res.result(boost::beast::http::status::bad_request);
+                    return;
+                }
+                x570d4u::respondStaged(resp, header.substr(begin, end - begin), part.content, false);
+            });
+
+    BMCWEB_ROUTE(app, "/redfish/v1/Registries/<str>/")
+        .methods(boost::beast::http::verb::post)(
+            [](crow::Request& req, const std::shared_ptr<bmcweb::AsyncResp>& resp,
+               const std::string& name) {
+                if (!x570d4u::isHost(req) || !name.starts_with("BiosAttributeRegistry") || !name.ends_with(".json"))
+                {
+                    resp->res.result(boost::beast::http::status::forbidden);
+                    return;
+                }
+                x570d4u::respondStaged(resp, name, req.body());
+            });
+
+    BMCWEB_ROUTE(app, "/redfish/v1/Systems/<str>/Smbios/")
+        .methods(boost::beast::http::verb::post)(
+            [](crow::Request& req, const std::shared_ptr<bmcweb::AsyncResp>& resp,
+               const std::string& system) {
+                if (!x570d4u::isHost(req) || system != "Self")
+                {
+                    resp->res.result(boost::beast::http::status::forbidden);
+                    return;
+                }
+                const std::string_view type = req.getHeaderValue(boost::beast::http::field::content_type);
+                constexpr std::string_view prefix = "multipart/form-data; boundary=";
+                const std::string_view body = req.body();
+                if (!type.starts_with(prefix) || type.size() <= prefix.size() || type.size() > prefix.size() + 70)
+                {
+                    resp->res.result(boost::beast::http::status::bad_request);
+                    return;
+                }
+                const std::string boundary = "--" + std::string(type.substr(prefix.size()));
+                if (!body.starts_with(boundary + "\r\n"))
+                {
+                    resp->res.result(boost::beast::http::status::bad_request);
+                    return;
+                }
+                const auto headersEnd = body.find("\r\n\r\n", boundary.size());
+                if (headersEnd == body.npos || headersEnd > 2048 ||
+                    !body.substr(boundary.size(), headersEnd - boundary.size()).contains("name=\"file\""))
+                {
+                    resp->res.result(boost::beast::http::status::bad_request);
+                    return;
+                }
+                const auto begin = headersEnd + 4;
+                const auto end = body.find("\r\n" + boundary + "--", begin);
+                if (end == body.npos || !x570d4u::stageUpload("Smbios.dat", body.substr(begin, end - begin)))
+                {
+                    resp->res.result(boost::beast::http::status::bad_request);
+                    return;
+                }
+                resp->res.result(boost::beast::http::status::ok);
+            });
+
+    BMCWEB_ROUTE(app, "/redfish/v1/Systems/<str>/Bios/")
+        .methods(boost::beast::http::verb::post)(
+            [](crow::Request& req, const std::shared_ptr<bmcweb::AsyncResp>& resp,
+               const std::string& system) {
+                if (!x570d4u::isHost(req) || system != "Self")
+                {
+                    resp->res.result(boost::beast::http::status::forbidden);
+                    return;
+                }
+                x570d4u::respondStaged(resp, "bios.json", req.body());
+            });
+
+    BMCWEB_ROUTE(app, "/redfish/v1/Oem/Ami/InventoryData")
+        .methods(boost::beast::http::verb::get)(
+            [](crow::Request& req, const std::shared_ptr<bmcweb::AsyncResp>& resp) {
+                if (!x570d4u::isHost(req))
+                {
+                    resp->res.result(boost::beast::http::status::forbidden);
+                    return;
+                }
+                auto& data = resp->res.jsonValue;
+                data["System"]["Id"] = "Self";
+                data["System"]["@odata.id"] = "/redfish/v1/Systems/Self";
+                data["System"]["Storage"]["@odata.id"] = "/redfish/v1/Systems/Self/Storage";
+                data["System"]["Memory"]["@odata.id"] = "/redfish/v1/Systems/Self/Memory";
+                data["System"]["Oem"]["Ami"]["Bios"]["Inventory"]["Crc"]["@odata.id"] = "/redfish/v1/Systems/Self/Oem/Ami/Inventory/Crc";
+                data["Chassis"] = {{"Id", "Self"}, {"@odata.id", "/redfish/v1/Chassis/Self"}};
+                data["SecureBoot"] = nlohmann::json::object();
+                data["Registries"] = nlohmann::json::array();
+                data["NetworkDeviceFunctions"] = nlohmann::json::array();
+            });
+
+    BMCWEB_ROUTE(app, "/redfish/v1/Oem/Ami/InventoryData")
+        .methods(boost::beast::http::verb::post)(
+            [](crow::Request& req, const std::shared_ptr<bmcweb::AsyncResp>& resp) {
+                if (!x570d4u::isHost(req))
+                {
+                    resp->res.result(boost::beast::http::status::forbidden);
+                    return;
+                }
+                const auto parts = req.multipart();
+                if (parts.size() != 1 || !x570d4u::saveInventory(x570d4u::getPayload(req)))
+                {
+                    resp->res.result(boost::beast::http::status::bad_request);
+                    return;
+                }
+                resp->res.result(boost::beast::http::status::created);
+                resp->res.addHeader(boost::beast::http::field::location,
+                                    "/redfish/v1/Oem/Ami/InventoryData");
+            });
+
+    BMCWEB_ROUTE(app, "/redfish/v1/Oem/Ami/InventoryData")
+        .methods(boost::beast::http::verb::patch)(
+            [](crow::Request& req, const std::shared_ptr<bmcweb::AsyncResp>& resp) {
+                if (!x570d4u::isHost(req))
+                {
+                    resp->res.result(boost::beast::http::status::forbidden);
+                    return;
+                }
+                const auto payload = nlohmann::json::parse(req.body(), nullptr, false);
+                if (!payload.is_object() || !payload.contains("BootComplete") ||
+                    !payload["BootComplete"].is_boolean())
+                {
+                    resp->res.result(boost::beast::http::status::bad_request);
+                    return;
+                }
+                if (payload["BootComplete"].get<bool>())
+                {
+                    std::error_code ec;
+                    std::filesystem::rename(x570d4u::pendingInventoryPath,
+                                            x570d4u::inventoryPath, ec);
+                    if (ec)
+                    {
+                        resp->res.result(boost::beast::http::status::conflict);
+                        return;
+                    }
+                }
+                resp->res.result(boost::beast::http::status::no_content);
+            });
+}
+} // namespace redfish
