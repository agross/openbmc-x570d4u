+    uint16_t sensorNum = 300;
+    uint16_t sensorIndex = sensorNum;
     for (const auto& sensor : *sensorTree)
     {
+        auto fixed = sensorNumbers.find(sensor.first);
+        if (fixed != sensorNumbers.end())
+        {
+            sensorNumMapPtr->insert(
+                SensorNumMap::value_type(fixed->second, sensor.first));
+            continue;
+        }
+        // Retain dynamic discovery for additional sensors, outside board slots.
         sensorNumMapPtr->insert(
             SensorNumMap::value_type(sensorNum, sensor.first));
         sensorIndex++;
